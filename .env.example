# ===== App =====
APP_NAME=JadeAI

# ===== Auth =====
AUTH_ENABLED=false
AUTH_SECRET=your-auth-secret-key-change-me

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ===== Database =====
# sqlite (default, zero-config) or postgresql
DB_TYPE=sqlite

# PostgreSQL (when DB_TYPE=postgresql)
DATABASE_URL=postgresql://user:password@localhost:5432/jadeai

# SQLite (when DB_TYPE=sqlite)
SQLITE_PATH=./data/jade.db

# ===== Runtime =====
# Set to `desktop` to run as a single local-user desktop client: skips
# fingerprint and NextAuth, and the database only ever has one user (id `local`).
JADE_RUNTIME=

# Optional desktop resume collector override. Packaged clients default to
# https://api.webarcx.com; set this only to use another endpoint during development.
JADE_RESUME_COLLECTOR_URL=

# ===== i18n =====
DEFAULT_LOCALE=zh
